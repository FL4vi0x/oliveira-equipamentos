<div class="page">
  <!-- CABEÇALHO COM LOGO -->
  <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:2px solid #1a1a1a; padding-bottom:8px; margin-bottom:10px;">
    <div style="flex:2;">
      {{#if logos.horizontal}}
      <img src="{{logos.horizontal}}" alt="Oliveira Equipamentos" style="height:64px; max-width:260px; object-fit:contain; display:block;" />
      {{/if}}
      <div style="font-size:8pt; margin-top:4px; color:#444;">
        {{empresa.endereco}}, {{empresa.numero}} — {{empresa.bairro}}<br/>
        CEP: {{empresa.cep}} — {{empresa.cidade}}/{{empresa.estado}}<br/>
        CNPJ: {{empresa.cnpj}} | Tel: {{empresa.telefone}}
      </div>
    </div>
    <div style="flex:1; text-align:right;">
      <h1 style="font-size:16pt; margin:0;">CONTRATO</h1>
      <h2 style="font-size:14pt; margin:0;">{{venda.numero}}</h2>
      <p style="font-size:12pt; font-weight:bold; margin:5px 0;">Produtos</p>
    </div>
  </div>

  <!-- INFO CLIENTE -->
  <div style="background: #f3f4f6; padding: 10px; border-radius: 4px; margin-bottom: 15px; font-size: 9pt; display: grid; grid-template-columns: 1fr 1fr; gap: 5px;">
    <div><strong>Cliente:</strong> {{cliente.nome}}</div>
    <div style="text-align: right;"><strong>Data:</strong> {{formatDate venda.dataVenda}}</div>
    <div><strong>Endereço:</strong> {{cliente.endereco}}, {{cliente.numero}}</div>
    <div style="text-align: right;"><strong>CPF/CNPJ:</strong> {{cliente.cpfCnpj}}</div>
    <div><strong>Bairro:</strong> {{cliente.bairro}}</div>
    <div style="text-align: right;"><strong>Cidade:</strong> {{cliente.cidade}}/{{cliente.estado}}</div>
  </div>

  <!-- TABELA DE PRODUTOS -->
  <table style="width: 100%; border-collapse: collapse; font-size: 8.5pt;">
    <thead>
      <tr style="background: #000; color: #fff;">
        <th style="padding: 5px; text-align: left; border: 1px solid #000;">Cod</th>
        <th style="padding: 5px; text-align: left; border: 1px solid #000;">Descrição do Produto / Item</th>
        <th style="padding: 5px; text-align: left; border: 1px solid #000;">Garantia</th>
        <th style="padding: 5px; text-align: center; border: 1px solid #000;">Und</th>
        <th style="padding: 5px; text-align: center; border: 1px solid #000;">Qtd</th>
        <th style="padding: 5px; text-align: right; border: 1px solid #000;">Unitário</th>
        <th style="padding: 5px; text-align: right; border: 1px solid #000;">Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each itens}}
      <tr>
        <td style="padding: 5px; border: 1px solid #ccc;">{{incrementedIndex @index}}</td>
        <td style="padding: 5px; border: 1px solid #ccc;">{{produto.nome}}</td>
        <td style="padding: 5px; border: 1px solid #ccc;">LOJA 03 MESES</td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: center;">UN</td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: center;">{{quantidade}}</td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: right;">{{formatCurrency precoUnitario}}</td>
        <td style="padding: 5px; border: 1px solid #ccc; text-align: right;">{{formatCurrency subtotal}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- RESUMO -->
  <div style="margin-top: 10px; border: 1px solid #000; padding: 5px; display: flex; justify-content: space-between; font-size: 9pt; font-weight: bold;">
    <div>Valor dos Produtos: {{formatCurrency venda.total}}</div>
    <div>Total do Pedido: {{formatCurrency venda.total}}</div>
  </div>

  <div style="margin-top: 15px; font-size: 8pt; border: 1px solid #ccc; padding: 10px;">
    <strong>Observações:</strong> <br/>
    DOCUMENTO EMITIDO POR "ME" OPTANTE PELO SIMPLES NACIONAL. NÃO GERA CRÉDITO DE ICMS NEM IPI.
  </div>

  <!-- ASSINATURAS -->
  <div style="margin-top: 40mm; display: flex; justify-content: space-around; page-break-inside: avoid;">
    <div style="text-align: center; width: 45%;">
      <div style="border-top: 1px solid #000; padding-top: 5px;"></div>
      <p style="font-size: 9pt; font-weight: bold; margin: 0;">{{empresa.nome}}</p>
      <p style="font-size: 8pt; color: #555;">VENDEDORA</p>
    </div>
    <div style="text-align: center; width: 45%;">
      <div style="border-top: 1px solid #000; padding-top: 5px;"></div>
      <p style="font-size: 9pt; font-weight: bold; margin: 0;">{{cliente.nome}}</p>
      <p style="font-size: 8pt; color: #555;">COMPRADOR(A)</p>
    </div>
  </div>
</div>
