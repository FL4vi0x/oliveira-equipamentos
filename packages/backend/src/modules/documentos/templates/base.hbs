<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Documentos de Venda</title>
  <style>
    /* =========================================================
       RESET & TIPOGRAFIA
    ========================================================= */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11pt;
      color: #1a1a1a;
      background: #fff;
    }

    /* =========================================================
       PÁGINA A4
    ========================================================= */
    .page {
      width: 210mm;
      min-height: 297mm;
      padding: 15mm 15mm 15mm 15mm;
      margin: 0 auto;
      background: #fff;
      page-break-after: always;
      position: relative;
    }

    .page:last-child {
      page-break-after: auto;
    }

    /* =========================================================
       CABEÇALHO DE DOCUMENTO
    ========================================================= */
    .doc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #1a1a1a;
      padding-bottom: 8px;
      margin-bottom: 16px;
    }

    .doc-header-left h1 {
      font-size: 15pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .doc-header-left p {
      font-size: 9pt;
      color: #555;
      margin-top: 2px;
    }

    .doc-header-right {
      text-align: right;
      font-size: 9pt;
      color: #333;
    }

    .doc-header-right strong {
      font-size: 11pt;
    }

    /* =========================================================
       EMPRESA CABEÇALHO
    ========================================================= */
    .empresa-header {
      text-align: center;
      margin-bottom: 12px;
      padding-bottom: 10px;
      border-bottom: 1px solid #ccc;
    }

    .empresa-header h2 {
      font-size: 14pt;
      font-weight: 700;
      text-transform: uppercase;
    }

    .empresa-header p {
      font-size: 9pt;
      color: #555;
      margin-top: 3px;
    }

    /* =========================================================
       SEÇÃO DE DADOS (CLIENTE, ETC.)
    ========================================================= */
    .section {
      margin-bottom: 14px;
    }

    .section-title {
      font-size: 10pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      border-bottom: 1px solid #ccc;
      padding-bottom: 4px;
      margin-bottom: 8px;
      color: #333;
    }

    .dados-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 16px;
    }

    .dados-grid.full {
      grid-template-columns: 1fr;
    }

    .dado-item {
      font-size: 10pt;
    }

    .dado-item label {
      font-weight: 700;
      font-size: 9pt;
      color: #555;
    }

    .dado-item span {
      margin-left: 4px;
    }

    /* =========================================================
       TABELAS
    ========================================================= */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
      font-size: 10pt;
    }

    thead th {
      background: #1a1a1a;
      color: #fff;
      padding: 6px 8px;
      text-align: left;
      font-size: 9pt;
      font-weight: 700;
      text-transform: uppercase;
    }

    tbody tr:nth-child(even) {
      background: #f5f5f5;
    }

    tbody td {
      padding: 5px 8px;
      border-bottom: 1px solid #ddd;
    }

    tfoot td {
      padding: 5px 8px;
      font-weight: 700;
      border-top: 2px solid #1a1a1a;
    }

    .text-right {
      text-align: right;
    }

    .text-center {
      text-align: center;
    }

    /* =========================================================
       TOTAIS
    ========================================================= */
    .totais-box {
      margin-left: auto;
      width: 60%;
      border: 1px solid #ccc;
      border-radius: 4px;
      overflow: hidden;
      margin-bottom: 12px;
    }

    .totais-row {
      display: flex;
      justify-content: space-between;
      padding: 5px 10px;
      font-size: 10pt;
      border-bottom: 1px solid #eee;
    }

    .totais-row:last-child {
      border-bottom: none;
      background: #1a1a1a;
      color: #fff;
      font-weight: 700;
      font-size: 11pt;
    }

    /* =========================================================
       TEXTO JURÍDICO
    ========================================================= */
    .texto-juridico {
      font-size: 10pt;
      line-height: 1.6;
      text-align: justify;
    }

    .texto-juridico p {
      margin-bottom: 8px;
    }

    .clausula {
      margin-bottom: 10px;
    }

    .clausula-titulo {
      font-weight: 700;
      font-size: 10pt;
    }

    /* =========================================================
       ASSINATURA
    ========================================================= */
    .assinaturas {
      display: flex;
      justify-content: space-between;
      margin-top: 24px;
      gap: 20px;
      page-break-inside: avoid;
    }

    .assinatura-box {
      flex: 1;
      text-align: center;
    }

    .assinatura-linha {
      border-top: 1px solid #1a1a1a;
      margin-bottom: 5px;
      margin-top: 36px;
    }

    .assinatura-box p {
      font-size: 9pt;
      color: #555;
    }

    /* =========================================================
       PROMISSÓRIAS — GRID 2x2 POR FOLHA
    ========================================================= */
    .promissorias-folha {
      width: 210mm;
      height: 297mm;
      padding: 8mm;
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 4mm;
      page-break-after: always;
    }

    .promissorias-folha:last-child {
      page-break-after: auto;
    }

    .promissoria {
      border: 1.5px solid #1a1a1a;
      border-radius: 3px;
      padding: 6mm 7mm;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      overflow: hidden;
    }

    .promissoria-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 1px solid #ccc;
      padding-bottom: 4px;
      margin-bottom: 6px;
    }

    .promissoria-titulo {
      font-size: 9pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .promissoria-numero {
      font-size: 8pt;
      color: #555;
      background: #f0f0f0;
      padding: 2px 6px;
      border-radius: 2px;
      font-weight: 700;
    }

    .promissoria-valor-destaque {
      text-align: center;
      margin: 6px 0;
    }

    .promissoria-valor-destaque .valor-label {
      font-size: 7.5pt;
      text-transform: uppercase;
      color: #555;
      display: block;
      margin-bottom: 2px;
    }

    .promissoria-valor-destaque .valor {
      font-size: 22pt;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .promissoria-info {
      font-size: 8.5pt;
      line-height: 1.5;
    }

    .promissoria-info-row {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid #eee;
      padding: 2px 0;
    }

    .promissoria-info-row label {
      font-weight: 700;
      color: #555;
    }

    .promissoria-assinatura {
      margin-top: 8px;
      border-top: 1px solid #1a1a1a;
      padding-top: 3px;
      text-align: center;
      font-size: 7.5pt;
      color: #666;
    }

    .promissoria-empresa {
      font-size: 7.5pt;
      color: #666;
      text-align: center;
      margin-top: 4px;
    }

    /* =========================================================
       RODAPÉ DO DOCUMENTO
    ========================================================= */
    .doc-footer {
      position: absolute;
      bottom: 10mm;
      left: 15mm;
      right: 15mm;
      border-top: 1px solid #ccc;
      padding-top: 4px;
      display: flex;
      justify-content: space-between;
      font-size: 8pt;
      color: #888;
    }

    /* =========================================================
       UTILITÁRIOS
    ========================================================= */
    .bold { font-weight: 700; }
    .mt-4 { margin-top: 4mm; }
    .mt-8 { margin-top: 8mm; }
    .highlight { background: #f9f9f9; padding: 4px 8px; border-left: 3px solid #1a1a1a; }

    /* =========================================================
       @MEDIA PRINT
    ========================================================= */
    @media print {
      html, body {
        margin: 0;
        padding: 0;
      }

      .page {
        margin: 0;
        box-shadow: none;
        page-break-after: always;
      }

      .promissorias-folha {
        page-break-after: always;
      }
    }
  </style>
</head>
<body>
  {{{content}}}
</body>
</html>
